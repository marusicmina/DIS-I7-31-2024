# Primer promenljivih okruženja za produkcijsku konfiguraciju.
#
# Ovaj fajl služi kao šablon i ne sadrži prave vrednosti.
# Pre pokretanja produkcijske konfiguracije potrebno ga je kopirati:
#
#   cp .env.prod.example .env
#
# i u novom .env fajlu uneti stvarne vrednosti.
#
# Fajl .env se nalazi u .gitignore, tako da lozinke ne završe u repozitorijumu.

# Lozinke baza podataka. Svaki servis ima svoju bazu i svog korisnika.
SALON_DB_PASSWORD=promeni-me
AUTH_DB_PASSWORD=promeni-me
CATALOG_DB_PASSWORD=promeni-me
STAFF_DB_PASSWORD=promeni-me
BOOKING_DB_PASSWORD=promeni-me

# Tajni ključ za potpisivanje JWT tokena, minimum 32 karaktera.
# Može se generisati komandom: openssl rand -base64 48
JWT_SECRET=promeni-me-minimum-32-karaktera-duga-tajna

# Odakle se povlače Docker image-i koje objavljuje pipeline.
# Za GitHub Container Registry format je ghcr.io/<korisnicko-ime>
IMAGE_PREFIX=ghcr.io/marusicmina
IMAGE_TAG=latest

# Port na kome Gateway sluša na host mašini.
GATEWAY_PORT=8080
